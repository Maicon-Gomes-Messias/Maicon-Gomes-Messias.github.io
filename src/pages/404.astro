---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/lib/site";
---

<BaseLayout title={`Página não encontrada — ${site.name}`} noindex>
  <main
    class="mx-auto flex min-h-dvh w-full max-w-[1180px] flex-col justify-center px-5 py-24 sm:px-8"
  >
    <p class="data text-signal">Erro 404</p>
    <h1 class="mt-3 font-display text-h2 font-semibold text-ink">Página não encontrada</h1>
    <p class="mt-5 max-w-[52ch] text-lead text-ink-soft">
      O endereço que você abriu não existe neste site. Pode ter havido um erro de digitação ou o
      link ficou desatualizado.
    </p>
    <div class="mt-8">
      <a
        href="/"
        class="inline-block rounded-[var(--radius-instrument)] bg-ink px-5 py-2.5 text-small font-medium text-paper hover:bg-signal"
      >
        Voltar ao início
      </a>
    </div>
  </main>
</BaseLayout>
