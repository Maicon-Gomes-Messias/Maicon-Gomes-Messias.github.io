---
import { getImage } from "astro:assets";
import { Capabilities } from "@/components/Capabilities";
import { Contact } from "@/components/Contact";
import { Credentials } from "@/components/Credentials";
import { Footer } from "@/components/Footer";
import { Hero } from "@/components/Hero";
import { Profile } from "@/components/Profile";
import { Projects } from "@/components/Projects";
import { SiteHeader } from "@/components/SiteHeader";
import { Trajectory } from "@/components/Trajectory";
import { awards, certifications, projects } from "@/content/profile";
// Import relativo de propósito: o alias `@/` não resolveu para assets no
// modo de desenvolvimento (`astro dev`), embora funcionasse no build.
import fotoPerfil from "../assets/foto-perfil.jpg";
import tccFluxograma from "../assets/tcc-fluxograma.png";
import tccLayout from "../assets/tcc-layout.png";
import tccMapaCalor from "../assets/tcc-mapa-calor.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { description, site, siteTitle, siteUrl } from "@/lib/site";

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const articleId = `${siteUrl}/#artigo-ocupacao-wifi`;

const [thesis] = projects;
const publication = thesis.publication;
const articleAuthors = publication
  ? publication.authors.map((name) =>
      name === site.name ? { "@id": personId } : { "@type": "Person", name },
    )
  : [];

// 400px é o tamanho nativo da foto; renderizada a 240px dá ~1,7x (retina).
// Não há ganho em pedir mais que isso — só aumentaria o arquivo.
const [retrato, heatmap, fluxograma, layout] = await Promise.all([
  getImage({ src: fotoPerfil, format: "avif", width: 400, quality: 78 }),
  getImage({ src: tccMapaCalor, format: "avif", width: 1600, quality: 80 }),
  getImage({ src: tccFluxograma, format: "avif", width: 1200, quality: 80 }),
  getImage({ src: tccLayout, format: "avif", width: 841, quality: 80 }),
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: site.name,
      alternateName: site.shortName,
      jobTitle: "Técnico de TI Nível I",
      description,
      url: siteUrl,
      email: `mailto:${site.email}`,
      telephone: site.phone,
      image: `${siteUrl}${retrato.src}`,
      address: {
        "@type": "PostalAddress",
        addressLocality: site.location.locality,
        addressRegion: site.location.region,
        addressCountry: site.location.country,
      },
      worksFor: {
        "@type": "Organization",
        name: "Pontifícia Universidade Católica de Minas Gerais",
        url: "https://www.pucminas.br",
      },
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Pontifícia Universidade Católica de Minas Gerais",
        url: "https://www.pucminas.br",
      },
      knowsLanguage: ["pt-BR", "en"],
      sameAs: [site.github, site.linkedin],
      subjectOf: { "@id": articleId },
      knowsAbout: [
        "Suporte técnico de TI",
        "Infraestrutura de TI",
        "Redes de computadores",
        "Cloud computing",
        "Amazon Web Services",
        "Administração de ambientes Windows",
        "Segurança da informação",
        "Python",
        "Análise de dados",
        "Machine learning",
        "Internet das Coisas",
        "ESP32",
      ],
      award: awards.map((item) => item.title),
      hasCredential: certifications.map((item) => ({
        "@type": "EducationalOccupationalCredential",
        name: item.title,
        recognizedBy: { "@type": "Organization", name: item.issuer },
      })),
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl,
      name: site.name,
      inLanguage: "pt-BR",
      publisher: { "@id": personId },
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/#page`,
      url: siteUrl,
      name: siteTitle,
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
      inLanguage: "pt-BR",
    },
    ...(publication
      ? [
          {
            "@type": "ScholarlyArticle",
            "@id": articleId,
            headline: thesis.title,
            name: thesis.title,
            author: articleAuthors,
            datePublished: "2025-06",
            inLanguage: "pt-BR",
            url: `${siteUrl}${publication.pdf}`,
            about: ["Monitoramento de ocupação", "Redes Wi-Fi", "Mapas de calor"],
            isPartOf: {
              "@type": "Periodical",
              name: publication.venue,
              issn: "2316-9451",
              publisher: { "@type": "Organization", name: "PUC Minas" },
            },
          },
        ]
      : []),
  ],
};
---

<BaseLayout>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  />

  <SiteHeader />

  <main id="conteudo">
    <Hero retrato={retrato} heatmap={heatmap} />
    <Profile />
    <Trajectory />
    <Projects figures={{ heatmap, fluxograma, layout }} />
    <Capabilities />
    <Credentials />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
