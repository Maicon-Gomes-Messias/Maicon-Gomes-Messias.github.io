---
import { Capabilities } from "@/components/Capabilities";
import { Contact } from "@/components/Contact";
import { Credentials } from "@/components/Credentials";
import { Footer } from "@/components/Footer";
import { Hero } from "@/components/Hero";
import { Profile } from "@/components/Profile";
import { Projects } from "@/components/Projects";
import { Publications } from "@/components/Publications";
import { SiteHeader } from "@/components/SiteHeader";
import { Trajectory } from "@/components/Trajectory";
import { awards, certifications, projects } from "@/content/profile";
// Import relativo de propósito: o alias `@/` não resolveu para assets no
// modo de desenvolvimento (`astro dev`), embora funcionasse no build.
import fotoPerfil from "../assets/foto-perfil.jpg";
import oculosHardwareImg from "../assets/oculos-hardware.jpg";
import oculosPrototipoImg from "../assets/oculos-prototipo.jpg";
import tccFluxograma from "../assets/tcc-fluxograma.png";
import tccLayout from "../assets/tcc-layout.png";
import tccMapaCalor from "../assets/tcc-mapa-calor.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { responsiveImage } from "@/lib/responsive";
import { description, site, siteTitle, siteUrl } from "@/lib/site";

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const articleId = `${siteUrl}/#artigo-ocupacao-wifi`;

const [thesis] = projects;
const publication = thesis.publication;
const articleAuthors = publication
  ? publication.authors.map((name) =>
      name === site.name ? { "@id": personId } : { "@type": "Person", name },
    )
  : [];

// O retrato é exibido a 200px (celular) e 240px. Servido em srcSet para não
// baixar a versão de 400px onde ela não é necessária.
const [photo, heatmap, fluxograma, layout, oculosHardware, oculosPrototipo] = await Promise.all([
  responsiveImage(fotoPerfil, [240, 350, 400], { quality: 66 }),
  responsiveImage(tccMapaCalor, [480, 800, 1200, 1800], { quality: 78 }),
  responsiveImage(tccFluxograma, [480, 900, 1291]),
  responsiveImage(tccLayout, [480, 841]),
  responsiveImage(oculosHardwareImg, [480, 900, 2000]),
  responsiveImage(oculosPrototipoImg, [480, 900, 1599]),
]);

const retratoAsset = photo;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: site.name,
      alternateName: site.shortName,
      jobTitle: "Técnico de TI Nível I",
      description,
      url: siteUrl,
      email: `mailto:${site.email}`,
      image: `${siteUrl}${photo.src}`,
      address: {
        "@type": "PostalAddress",
        addressLocality: site.location.locality,
        addressRegion: site.location.region,
        addressCountry: site.location.country,
      },
      worksFor: {
        "@type": "Organization",
        name: "Pontifícia Universidade Católica de Minas Gerais",
        url: "https://www.pucminas.br",
      },
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Pontifícia Universidade Católica de Minas Gerais",
        url: "https://www.pucminas.br",
      },
      knowsLanguage: ["pt-BR", "en"],
      sameAs: [site.github, site.linkedin],
      subjectOf: { "@id": articleId },
      knowsAbout: [
        "Suporte técnico de TI",
        "Infraestrutura de TI",
        "Redes de computadores",
        "Cloud computing",
        "Amazon Web Services",
        "Administração de ambientes Windows",
        "Segurança da informação",
        "Python",
        "Análise de dados",
        "Machine learning",
        "Internet das Coisas",
        "ESP32",
        "Java",
        "Node.js",
        "Banco de dados SQL",
        "VHDL e FPGA",
      ],
      award: awards.map((item) => item.title),
      hasCredential: certifications.map((item) => ({
        "@type": "EducationalOccupationalCredential",
        name: item.title,
        recognizedBy: { "@type": "Organization", name: item.issuer },
      })),
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl,
      name: site.name,
      inLanguage: "pt-BR",
      publisher: { "@id": personId },
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/#page`,
      url: siteUrl,
      name: siteTitle,
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
      inLanguage: "pt-BR",
    },
    ...(publication
      ? [
          {
            "@type": "ScholarlyArticle",
            "@id": articleId,
            headline: thesis.title,
            name: thesis.title,
            author: articleAuthors,
            datePublished: "2025-06",
            inLanguage: "pt-BR",
            url: `${siteUrl}${publication.pdf}`,
            about: ["Monitoramento de ocupação", "Redes Wi-Fi", "Mapas de calor"],
            isPartOf: {
              "@type": "Periodical",
              name: publication.venue,
              issn: "2316-9451",
              publisher: { "@type": "Organization", name: "PUC Minas" },
            },
          },
        ]
      : []),
  ],
};
---

<BaseLayout>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  />

  <SiteHeader />

  <main id="conteudo">
    <Hero retrato={retratoAsset} />
    <Profile />
    <Trajectory />
    <Projects figures={{ heatmap, fluxograma, layout, oculosHardware, oculosPrototipo }} />
    <Publications />
    <Capabilities />
    <Credentials />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
